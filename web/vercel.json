{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "env": {
    "FIELD_DOJO_URL": "http://localhost:7410",
    "FIELD_OBIWAN_URL": "http://localhost:9630",
    "FIELD_ATLAS_URL": "http://localhost:5280",
    "FIELD_TATA_URL": "http://localhost:4320",
    "FIELD_AKRON_URL": "http://localhost:3960"
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" }
      ]
    }
  ]
}
